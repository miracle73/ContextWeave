# --- LLM (required) ---
OPENROUTER_API_KEY=sk-or-v1-...
OPENROUTER_MODELS=openai/gpt-4o-mini,anthropic/claude-sonnet-4.5,google/gemini-2.5-flash
OPENROUTER_DEFAULT_MODEL=openai/gpt-4o-mini
APP_URL=http://localhost:3000

# --- Transcription ---
# deepgram = server-side streaming (recommended); browser = Web Speech API in Chrome/Edge (no key needed)
STT_PROVIDER=deepgram
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en

# --- Optional ---
# Persist chats: Neon/Postgres URL or sqlite:///chats.db (empty = in-memory)
DATABASE_URL=
GITHUB_TOKEN=
CORS_ORIGINS=http://localhost:3000
DEBOUNCE_MS=700
MAX_PROVISIONAL_PER_UTTERANCE=3
GENERATIONS_PER_MINUTE=20
MAX_UPLOAD_MB=10
